    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 1,
    "m_PreviewExpanded": false,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "SoftOceanLighting",
    "m_FunctionSource": "",
    "m_FunctionBody": "float3 geometricNormal = normalize(GeometryNormalWS);\nfloat3 normal = normalize(lerp(geometricNormal, normalize(NormalWS), RippleStrength));\nfloat3 view = normalize(ViewWS);\nfloat3 lightDirection;\nfloat3 lightColor;\nfloat shadow;\nfloat ambient;\n#if defined(SHADERGRAPH_PREVIEW) || !defined(UNLIT_REALTIME_LIGHTING)\nlightDirection = normalize(float3(0.4, 0.8, 0.3));\nlightColor = 1.0;\nshadow = 1.0;\nambient = 0.3;\n#else\nfloat4 shadowCoord;\n#if defined(_MAIN_LIGHT_SHADOWS_SCREEN) && !defined(_SURFACE_TYPE_TRANSPARENT)\nshadowCoord = ComputeScreenPos(TransformWorldToHClip(PositionWS));\n#else\nshadowCoord = TransformWorldToShadowCoord(PositionWS);\n#endif\nLight mainLight = GetMainLight(shadowCoord);\nlightDirection = normalize(mainLight.direction + float3(0.0, 0.00001, 0.0));\nlightColor = mainLight.color;\nshadow = MainLightShadow(shadowCoord, PositionWS, half4(1.0, 1.0, 1.0, 1.0), half4(0.0, 0.0, 0.0, 0.0));\nambient = dot(unity_AmbientSky.rgb, float3(0.2126, 0.7152, 0.0722));\n#endif\nfloat verticalGap;\n#if defined(SHADERGRAPH_PREVIEW)\nverticalGap = max(EyeDepthGap, 0.0);\n#else\nfloat3 cameraForward = -UNITY_MATRIX_V[2].xyz;\nverticalGap = max(EyeDepthGap, 0.0) * abs(view.y) / max(abs(dot(view, cameraForward)), 0.05);\n#endif\nfloat2 terrainSize = max(abs(TerrainSize.xz), float2(0.001, 0.001));\nfloat2 terrainUV = (PositionWS.xz - TerrainOrigin.xz) / terrainSize;\nfloat2 terrainEdgeMeters = min(terrainUV, 1.0 - terrainUV) * terrainSize;\nfloat terrainValidity = smoothstep(0.0, min(2.0, min(terrainSize.x, terrainSize.y) * 0.1),\n    min(terrainEdgeMeters.x, terrainEdgeMeters.y));\nfloat maximumDepth = max(DepthRange * 8.0, 20.0);\nfloat boundedTerrainDepth = lerp(maximumDepth, max(TerrainDepth, 0.0), terrainValidity);\n#if !defined(SHADERGRAPH_PREVIEW)\nif (SceneEyeDepth >= _ProjectionParams.z * 0.999)\n{\n    verticalGap = maximumDepth;\n}\n#endif\nfloat depth = max(0.0, min(boundedTerrainDepth, verticalGap));\nfloat depthBlend = smoothstep(0.0, max(DepthRange, 0.01), depth);\nfloat3 water = lerp(ShallowColor, DeepColor, depthBlend);\nfloat3 waveHighlight = lerp(HighlightColor, DeepColor * 1.8, depthBlend * 0.75);\nfloat3 controllerTint = ControllerColor / max(max(ControllerColor.r, ControllerColor.g), max(ControllerColor.b, 0.001));\nwater *= lerp(float3(1.0, 1.0, 1.0), controllerTint, ControllerTint);\nfloat halfLambert = dot(normal, lightDirection) * 0.5 + 0.5;\nfloat softness = max(LightSoftness, 0.01);\nfloat lightBand = smoothstep(0.45 - softness, 0.45 + softness, halfLambert);\nfloat highlightBand = smoothstep(0.80 - softness, 0.80 + softness, halfLambert);\nwater *= lerp(0.62, 1.0, lightBand) * lerp(0.65, 1.0, shadow);\nwater = lerp(water, waveHighlight, highlightBand * 0.045);\nfloat2 waveLightDirection = normalize(lightDirection.xz + float2(0.05, 0.02));\nfloat waveSlope = dot(geometricNormal.xz, waveLightDirection);\nfloat waveBand = smoothstep(-0.22, 0.22, waveSlope);\nwater *= lerp(1.0 - 0.65 * WaveContrast, 1.0 + 0.28 * WaveContrast, waveBand);\nfloat brightFace = smoothstep(0.10, 0.40, waveSlope);\nwater = lerp(water, waveHighlight, brightFace * WaveContrast * 0.28);\nfloat crestLight = smoothstep(0.10, 0.60, saturate(Crest));\nwater = lerp(water, waveHighlight, crestLight * CrestStrength);\n\nfloat fresnel = pow(1.0 - saturate(abs(dot(normal, view))), 4.0);\nwater = lerp(water, waveHighlight, fresnel * RimStrength);\nfloat3 halfDirection = normalize(lightDirection + view + float3(0.0, 0.00001, 0.0));\nfloat sunLobe = pow(saturate(dot(normal, halfDirection)), lerp(32.0, 112.0, saturate(Smoothness)));\nfloat sun = smoothstep(0.35, 0.8, sunLobe) * SpecularStrength * shadow;\nfloat lightLevel = max(lightColor.r, max(lightColor.g, lightColor.b));\nfloat exposure = clamp(0.25 + 0.7 * lightLevel + 0.25 * ambient, 0.18, 1.4);\nfloat3 lightTint = lerp(float3(1.0, 1.0, 1.0), lightColor / max(lightLevel, 0.001), 0.25);\nwater = water * exposure * lightTint + sun * lightColor;\n\nfloat surfaceAlpha = saturate(BaseAlpha);\n#if !defined(SHADERGRAPH_PREVIEW)\nif (PlanarAvailable > 0.5 && ReflectionStrength > 0.001)\n{\n    float3 cameraPosition = GetCameraPositionWS();\n    bool rightEye = dot(cameraPosition - PlanarRightEye, cameraPosition - PlanarRightEye)\n        < dot(cameraPosition - PlanarLeftEye, cameraPosition - PlanarLeftEye);\n    float4 reflectedClip = rightEye ? mul(PlanarRightVP, float4(PositionWS, 1.0))\n        : mul(PlanarLeftVP, float4(PositionWS, 1.0));\n    float2 reflectedUV = reflectedClip.xy / max(reflectedClip.w, 0.0001) * 0.5 + 0.5;\n#if UNITY_UV_STARTS_AT_TOP\n    reflectedUV.y = 1.0 - reflectedUV.y;\n#endif\n    reflectedUV += (normal.xz + geometricNormal.xz) * ReflectionDistortion * 0.015;\n    float edgeFade = saturate(min(min(reflectedUV.x, 1.0 - reflectedUV.x),\n        min(reflectedUV.y, 1.0 - reflectedUV.y)) * 25.0);\n    float reflectionWeight = ReflectionStrength * lerp(saturate(ReflectionFacingStrength), 0.85, fresnel) * edgeFade;\n    reflectionWeight *= step(0.0001, reflectedClip.w) * (1.0 - saturate(Underwater));\n    float surfaceDistance = distance(cameraPosition.xz, PositionWS.xz);\n    reflectionWeight *= 1.0 - smoothstep(ReflectionDistance * 0.6, max(ReflectionDistance, 0.01), surfaceDistance);\n    float lod = ReflectionRoughness * 6.0;\n    float4 reflectedSample;\n    if (rightEye)\n    {\n        reflectedSample = SAMPLE_TEXTURE2D_LOD(PlanarRightTexture.tex, PlanarRightTexture.samplerstate, reflectedUV, lod);\n    }\n    else\n    {\n        reflectedSample = SAMPLE_TEXTURE2D_LOD(PlanarLeftTexture.tex, PlanarLeftTexture.samplerstate, reflectedUV, lod);\n    }\n    float coverage = saturate(reflectedSample.a);\n    reflectionWeight = saturate(reflectionWeight * coverage);\n    float3 reflectedColor = reflectedSample.rgb / max(coverage, 0.0001);\n    reflectedColor *= float3(0.9, 0.97, 1.0);\n    float combinedAlpha = surfaceAlpha + reflectionWeight * (1.0 - surfaceAlpha);\n    water = (water * surfaceAlpha * (1.0 - reflectionWeight) + reflectedColor * reflectionWeight)\n        / max(combinedAlpha, 0.0001);\n    surfaceAlpha = combinedAlpha;\n}\n#endif\nfloat contactDepth = min(depth, verticalGap);\nfloat2 positionDx = ddx(PositionWS.xz);\nfloat2 positionDy = ddy(PositionWS.xz);\nfloat depthDx = ddx(contactDepth);\nfloat depthDy = ddy(contactDepth);\nfloat determinant = positionDx.x * positionDy.y - positionDx.y * positionDy.x;\nfloat safeDeterminant = (determinant < 0.0 ? -1.0 : 1.0) * max(abs(determinant), 0.000001);\nfloat2 depthGradient = float2(depthDx * positionDy.y - depthDy * positionDx.y,\n    depthDy * positionDx.x - depthDx * positionDy.x) / safeDeterminant;\nfloat shorelineDistance = contactDepth / clamp(length(depthGradient), 0.03, 4.0);\nfloat2 foamUV = PositionWS.xz * FoamScale;\nfloat motion = _Time.y * FoamSpeed;\nfloat edgeNoise = sin(foamUV.x * 1.7 + motion) * sin(foamUV.y * 1.3 - motion * 0.73);\nfloat animatedWidth = FoamWidth * (1.0 + 0.10 * edgeNoise);\nfloat edge = max(FoamSoftness, 0.005);\nfloat foam = (1.0 - smoothstep(max(animatedWidth - edge, 0.0), animatedWidth + edge, shorelineDistance));\nfoam *= step(0.0001, FoamWidth) * (1.0 - saturate(Underwater));\nfloat outerBand = 1.0 - smoothstep(edge, edge * 2.0, abs(shorelineDistance - animatedWidth * 1.45));\nouterBand *= smoothstep(0.15, 0.7, edgeNoise) * 0.12 * step(0.0001, FoamWidth);\nouterBand *= 1.0 - saturate(Underwater);\nfoam = saturate(max(foam, outerBand));\nfloat3 foamLighting = FoamColor * clamp(exposure, 0.5, 1.1);\nColor = lerp(water, foamLighting, foam);\nAlpha = max(surfaceAlpha, foam);"
}

